{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": { "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"] }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"],
        "urls": ["https://fonts.googleapis.com/**", "https://fonts.gstatic.com/**", "https://images.unsplash.com/**", "https://i.pravatar.cc/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-ultimo-conteudo",
      "urls": ["/api/**"],
      "cacheConfig": { "strategy": "freshness", "timeout": "4s", "maxSize": 500, "maxAge": "30d" }
    }
  ]
}
